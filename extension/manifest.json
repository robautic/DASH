{
  "manifest_version": 3,
  "name": "Dash e Pipe Companion",
  "version": "0.1.0",
  "description": "Leve o contexto do WhatsApp Web para o Dash e Pipe sem automatizar mensagens.",
  "permissions": ["sidePanel", "tabs", "activeTab", "storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Abrir Dash e Pipe" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
