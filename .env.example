# Supabase público (seguro para frontend com RLS)
NEXT_PUBLIC_SUPABASE_URL=https://ikgzyoltuiiwkrnjznml.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dz9m42mg4w9PB-B2N356Ag_79XOeuXR

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta Embedded Signup - valores públicos usados pelo SDK no navegador
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# Secrets necessários na Edge Function whatsapp-embedded-signup (configurar no Supabase Dashboard):
# META_APP_ID
# META_APP_SECRET
# WHATSAPP_GRAPH_API_VERSION=v25.0

# Conexão rápida via QR Code (configurar como secrets do Supabase, nunca no frontend):
# EVOLUTION_API_URL=https://seu-servidor-evolution.example
# EVOLUTION_API_KEY=sua-chave-global-secreta
# EVOLUTION_WEBHOOK_SECRET=gere-uma-chave-longa-e-aleatoria

# Coexistência e Cloud API dedicada usam o mesmo Embedded Signup; o modo é escolhido na interface.
# QR Code usa uma sessão de dispositivo vinculado do WhatsApp Web e não a API oficial da Meta.
# A Evolution envia MESSAGES_UPSERT e CONNECTION_UPDATE para whatsapp-qr-webhook,
# que valida x-dash-webhook-secret antes de normalizar os eventos para o mesmo pipeline interno.
# Nunca coloque service_role, META_APP_SECRET, EVOLUTION_API_KEY, EVOLUTION_WEBHOOK_SECRET ou tokens de WhatsApp em NEXT_PUBLIC_*.
