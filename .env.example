# ---- DataCrazy (usado só pelo server, nunca pelo client) ----
DATACRAZY_API_TOKEN=
DATACRAZY_API_BASE_URL=https://api.g1.datacrazy.io/api/v1
DATACRAZY_WEBHOOK_SECRET=

# ---- Firebase Admin (server) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave com \n literais (o server converte para quebras de linha reais)
FIREBASE_PRIVATE_KEY=

# ---- Server ----
NODE_ENV=development
PORT=8080
# Nível de log (pino): fatal|error|warn|info|debug|trace. Default: info em
# produção, debug em dev.
LOG_LEVEL=

# Origens permitidas por CORS, separadas por vírgula (ex: https://app.leaddash.com.br).
# OBRIGATÓRIO em produção — se vazio em produção, a API recusa toda requisição de browser.
ALLOWED_ORIGINS=http://localhost:5173

# ---- Frontend -> Backend (Vite) ----
VITE_API_BASE_URL=http://localhost:8080

# ---- Firebase client (Vite — precisam do prefixo VITE_ para chegar ao browser) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
